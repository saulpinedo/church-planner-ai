# ─── App ────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000

# ─── Google Calendar (Phase 2) ──────────────────────
# Service account flow. Create at console.cloud.google.com:
# 1. New project → enable Google Calendar API
# 2. Create service account, download JSON key
# 3. Share your church calendar with the service account email
#    ("Make changes to events" permission)
# 4. Paste the values below from the JSON.
#
# GOOGLE_CALENDAR_ID is the ID of the shared calendar. For a calendar you
# own it might be your email; for a shared one it's the long ID under
# Settings → Integrate calendar.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_CALENDAR_ID=

# ─── n8n + Telegram (Phase 5) ───────────────────────
N8N_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=

# ─── Web Push (Phase 6) ─────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com